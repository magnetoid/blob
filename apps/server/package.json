{
  "name": "@blob/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/index.ts",
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types src/index.ts",
    "worker": "node --env-file-if-exists=../../.env --experimental-strip-types src/worker.ts",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/db/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --experimental-strip-types src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@blob/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/multipart": "^9.0.1",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.34.5",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "uuidv7": "^1.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
