{
  "name": "@blob/shared",
  "version": "1.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "openapi-typescript openapi.json -o src/generated/api.d.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing --alphabetize --check && vitest run --typecheck",
    "openapi-types": "openapi-typescript openapi.json -o src/generated/api.d.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing --alphabetize"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vitest": "^2.1.9"
  }
}
