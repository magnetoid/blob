{
  "name": "blob",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @blob/api --filter @blob/web dev",
    "worker": "pnpm --filter @blob/api worker",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter @blob/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @blob/api lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "migrate": "pnpm --filter @blob/api migrate",
    "seed": "pnpm --filter @blob/api seed",
    "openapi": "pnpm --filter @blob/api openapi > packages/shared/openapi.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
