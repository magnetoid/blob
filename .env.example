# ─── core ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Inert, and kept only so nothing that reads this file is surprised by its absence:
# nothing reads it. The dev script, the start script and the image's CMD all pass
# --port 3000 explicitly. Map the port outside the container instead.
PORT=3000
# The public origin. Every mutating request is checked against it, so in production this
# is the real domain — a mismatch reads as "Blocked request." on sign-in.
PUBLIC_URL=http://localhost:5173

# Where the built client lives. Left unset in development, where Vite serves it and
# proxies /api and /ws here; the image sets it, and then the API serves both.
# WEB_DIST=/app/web

# ─── datastores ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://blob:blob@localhost:5432/blob
REDIS_URL=redis://localhost:6379

# ─── auth ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
SESSION_TTL_DAYS=30

# ─── object storage (MinIO in dev, any S3 in prod) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blob-files
S3_ACCESS_KEY=blobadmin
S3_SECRET_KEY=blobadmin123
S3_FORCE_PATH_STYLE=true
# Public base URL browsers use to reach MinIO (differs from S3_ENDPOINT in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ─── email (MailHog in dev) ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blob <chat@example.com>"

# ─── translation ─────────────────────────────────────────────────────────
# Off by default. Without a provider the Translate action on a message answers
# "Translation is not configured for this workspace yet." A person also needs a preferred
# language set in their profile before the buttons appear at all.
TRANSLATION_PROVIDER=disabled
# deepl | libretranslate. LibreTranslate needs the base URL of your instance.
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=

# ─── web push (npx web-push generate-vapid-keys) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── the agent Blob runs itself ──────────────────────────────────────────────
# Set these and every workspace gets @Blob: an assistant already in the public channels,
# which answers when it is mentioned. Leave LLM_PROVIDER=disabled and nothing is seeded —
# a workspace with no model keeps every agent it installed and simply has no built-in one.
#
# This key is the *server's*, unlike an installed agent's, which its own container holds.
# The built-in runtime spends it, which is why a manifest off the wire is refused if it
# asks for that runtime.
#
# Applied at boot: the reconcile that seeds existing workspaces runs at startup, because
# an environment variable changing already means a restart.
LLM_PROVIDER=disabled
LLM_API_KEY=
# Optional. A proxy, or an OpenAI-compatible server you run yourself.
LLM_BASE_URL=
# Optional. Empty means a current model rather than a cheap one — the built-in agent is
# the product's first impression.
LLM_MODEL=

# ─── hosting agents from a repository ────────────────────────────────────────
# Off by default, and off is fine: agents can still be registered as external apps and
# run wherever their author put them. This is only the "and run it for me" half.
#
# Blob never holds the Docker socket. The runner is whatever already owns that privilege
# on the host — see ADR 0010 and docs/apps.md.
AGENT_RUNNER=disabled
# Not COOLIFY_URL: Coolify injects that name itself, set to the app's own address.
COOLIFY_API_URL=
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT=production

# ─── the agent terminal ──────────────────────────────────────────────────────
# The in-app terminal for a hosted agent (`/cli` in a DM with one, admins only). It is an
# SSH session to whatever host runs the agent's container — Blob never holds the Docker
# socket. See docs/agent-terminal.md.
# `ssh` alone does nothing: HOST, KEY and HOST_KEY below are all required, and the
# terminal reports itself as not set up until every one of them is present.
AGENT_SHELL=disabled
AGENT_SHELL_HOST=
AGENT_SHELL_PORT=22
AGENT_SHELL_USER=root
# The key material itself, not a path to it — it is handed straight to the SSH client,
# so a filename is refused as an unusable key.
AGENT_SHELL_KEY=
# The expected host key, and it is mandatory: there is no way to skip verification, and
# leaving this empty switches the terminal off rather than trusting whatever answers.
AGENT_SHELL_HOST_KEY=

# ─── the SSRF escape hatch ───────────────────────────────────────────────────
# Registration refuses an app or agent endpoint on a private address, which is what stops
# a workspace admin pointing Blob at something inside your network. Turn it on only where
# the agents genuinely live on the same private network as Blob and you trust everyone who
# can install one.
AGENT_ALLOW_PRIVATE_ENDPOINTS=false
