# ─── core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:5173

# ─── datastores ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://blob:blob@localhost:5432/blob
REDIS_URL=redis://localhost:6379

# ─── auth ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
SESSION_TTL_DAYS=30

# ─── object storage (MinIO in dev, any S3 in prod) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blob-files
S3_ACCESS_KEY=blobadmin
S3_SECRET_KEY=blobadmin123
S3_FORCE_PATH_STYLE=true
# Public base URL browsers use to reach MinIO (differs from S3_ENDPOINT in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ─── email (MailHog in dev) ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blob <chat@example.com>"

# ─── web push (npx web-push generate-vapid-keys) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
